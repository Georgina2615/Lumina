rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Comprueba la identidad administrativa vigente
    function isActiveAdmin() {
      return request.auth != null
        && firestore.get(
          /databases/(default)/documents/usuarios/$(request.auth.uid)
        ).data.activo == true
        && firestore.get(
          /databases/(default)/documents/usuarios/$(request.auth.uid)
        ).data.rol == 'admin';
    }

    match /productos/{productId}/catalogo.webp {
      allow read: if true;
      allow create, update: if isActiveAdmin()
        && request.resource.size <= 1024 * 1024
        && request.resource.contentType == 'image/webp';
      allow delete: if isActiveAdmin();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
