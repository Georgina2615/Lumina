rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Acceso por identidad y rol
    function isSignedIn() { return request.auth != null; }
    function hasAnyRole(roles) {
      return isSignedIn()
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.activo == true
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol in roles;
    }
    function hasRole(role) { return hasAnyRole([role]); }
    function isAdmin() { return hasRole('admin'); }
    function isReception() { return hasRole('recepcion'); }
    function isClinical() { return hasRole('cosmetologa'); }
    function isReceptionOrAdmin() { return hasAnyRole(['recepcion', 'admin']); }
    function canReadOperations() {
      return hasAnyRole(['recepcion', 'admin', 'cosmetologa']);
    }
    function isOwnUser(userId) {
      return isSignedIn()
        && (
          userId == request.auth.uid
          || (
            request.auth.token.email is string
            && request.auth.token.email_verified == true
            && resource.data.correo == request.auth.token.email
          )
        );
    }
    function hasValidUserData() {
      return request.resource.data.correo is string
        && request.resource.data.rol in ['admin', 'recepcion', 'cosmetologa']
        && request.resource.data.activo is bool;
    }
    function hasExactFields(data, fields) {
      return data.keys().hasAll(fields) && data.keys().hasOnly(fields);
    }
    match /usuarios/{userId} {
      allow read: if isAdmin() || isOwnUser(userId);
      allow create: if isAdmin() && hasValidUserData();
      allow update: if isAdmin()
        && hasValidUserData()
        && (
          userId != request.auth.uid
          || (
            request.resource.data.rol == 'admin'
            && request.resource.data.activo == true
          )
        );
      allow delete: if isAdmin() && userId != request.auth.uid;
    }
    // Catalogo de servicios
    function hasValidServiceData(data) {
      return hasExactFields(data, [
          'nombre', 'precioCentavos', 'duracionServicioMinutos', 'tiempoPreparacionMinutos',
          'duracionBloqueMinutos', 'porcentajeAnticipo', 'activo', 'orden'
        ])
        && data.nombre is string && data.nombre == data.nombre.trim()
        && data.nombre.size() >= 2 && data.nombre.size() <= 120
        && data.precioCentavos is int && data.precioCentavos > 0
        && data.duracionServicioMinutos is int && data.duracionServicioMinutos == 150
        && data.tiempoPreparacionMinutos is int && data.tiempoPreparacionMinutos == 30
        && data.duracionBloqueMinutos is int && data.duracionBloqueMinutos == 180
        && data.porcentajeAnticipo is int && data.porcentajeAnticipo == 30
        && data.activo is bool
        && data.orden is int && data.orden >= 0;
    }
    function serviceAfter(serviceId) { return getAfter(/databases/$(database)/documents/servicios/$(serviceId)).data; }
    match /servicios/{serviceId} {
      allow read: if canReadOperations();
      allow create, update: if isAdmin()
        && hasValidServiceData(request.resource.data);
      allow delete: if false;
    }
    // Clientes e identidades normalizadas
    function clientBefore(clientId) { return get(/databases/$(database)/documents/clientes/$(clientId)).data; }
    function clientAfter(clientId) { return getAfter(/databases/$(database)/documents/clientes/$(clientId)).data; }
    function identityAfter(identityId) {
      return getAfter(/databases/$(database)/documents/identidadesClientes/$(identityId)).data;
    }
    function hasValidClientName(value) {
      return value is string
        && value == value.trim()
        && value.size() >= 2 && value.size() <= 150;
    }
    function hasValidClientPhone(phone, normalizedPhone) {
      return phone is string && normalizedPhone is string
        && phone == normalizedPhone
        && normalizedPhone.matches('[0-9]{10}');
    }
    function hasValidClientEmail(email, normalizedEmail) {
      return email is string && normalizedEmail is string
        && email == email.trim()
        && email == normalizedEmail
        && normalizedEmail == normalizedEmail.lower()
        && normalizedEmail.size() <= 254
        && !normalizedEmail.matches('.*[/].*')
        && (normalizedEmail == ''
          || normalizedEmail.matches('[^/@ ]+@[^/@ ]+[.][^/@ ]+'));
    }
    function hasValidClientEmailState(data) {
      let pendingCorrection = data.get('emailPendienteCorreccion', false);
      return pendingCorrection is bool
        && (
          (pendingCorrection == false
            && hasValidClientEmail(data.email, data.emailNormalizado)
          )
          || (pendingCorrection == true
            && data.email is string
            && data.email == data.email.trim()
            && data.email.size() > 0
            && data.email.size() <= 254
            && data.emailNormalizado is string
            && data.emailNormalizado == ''
          )
        );
    }
    function hasValidMigrationAudit(data) {
      let hasMigrationAudit = data.keys().hasAny(['migradoEn', 'migradoPor']);
      return !hasMigrationAudit
        || (
          data.keys().hasAll(['migradoEn', 'migradoPor'])
          && data.migradoEn is timestamp
          && data.migradoPor is string
          && data.migradoPor.size() > 0
        );
    }
    function hasValidClientCreator(data) {
      return (data.creadoPor is string && data.creadoPor.size() > 0)
        || (
          data.creadoPor == null
          && data.keys().hasAll(['migradoEn', 'migradoPor'])
          && data.migradoEn is timestamp
          && data.migradoPor is string
          && data.migradoPor.size() > 0
        );
    }
    function hasValidClientMerge(data) {
      let mergeFields = [
        'fusionadoCon', 'fusionadoEn', 'fusionadoPor', 'motivoFusion'
      ];
      return (data.fusionado == false && !data.keys().hasAny(mergeFields))
        || (
          data.fusionado == true
          && data.keys().hasAll(mergeFields)
          && data.fusionadoCon is string
          && data.fusionadoCon.size() > 0
          && data.fusionadoEn is timestamp
          && data.fusionadoPor is string
          && data.fusionadoPor.size() > 0
          && data.motivoFusion == 'duplicado_contacto'
        );
    }
    function hasValidClientCore(data) {
      return data.keys().hasAll([
          'nombreCompleto', 'telefono', 'telefonoNormalizado', 'email',
          'emailNormalizado', 'consentimientoFirmado',
          'fusionado', 'fechaRegistro', 'creadoPor'
        ])
        && data.keys().hasOnly([
          'nombreCompleto', 'telefono', 'telefonoNormalizado', 'email',
          'emailNormalizado', 'consentimientoFirmado', 'fusionado', 'fechaRegistro',
          'creadoPor', 'firmaUrl', 'fechaFirma', 'actualizadaEn', 'actualizadaPor',
          'emailPendienteCorreccion', 'migradoEn', 'migradoPor',
          'fusionadoCon', 'fusionadoEn', 'fusionadoPor', 'motivoFusion'
        ])
        && hasValidClientName(data.nombreCompleto)
        && hasValidClientPhone(data.telefono, data.telefonoNormalizado)
        && hasValidClientEmailState(data)
        && data.consentimientoFirmado is bool
        && data.fusionado is bool
        && data.fechaRegistro is timestamp
        && hasValidMigrationAudit(data)
        && hasValidClientCreator(data)
        && hasValidClientMerge(data)
        && data.get('firmaUrl', '') is string
        && data.get('fechaFirma', '') is string
        && data.get('actualizadaEn', request.time) is timestamp
        && data.get('actualizadaPor', '') is string;
    }
    function hasIdentityAfter(clientId, type, value) {
      let identityId = type + ':' + value;
      let identity = identityAfter(identityId);
      return identity.tipo == type
        && identity.valorNormalizado == value
        && identity.clienteId == clientId;
    }
    function hasRequiredIdentitiesAfter(clientId, data) {
      return hasIdentityAfter(clientId, 'telefono', data.telefonoNormalizado)
        && (
          data.emailNormalizado == ''
          || hasIdentityAfter(clientId, 'correo', data.emailNormalizado)
        );
    }
    function releasesIdentity(type, previousValue, nextValue) {
      let identityId = type + ':' + previousValue;
      return previousValue == ''
        || previousValue == nextValue
        || !existsAfter(/databases/$(database)/documents/identidadesClientes/$(identityId));
    }
    function hasPairedContactChanges() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return !changed.hasAny(['telefono', 'telefonoNormalizado'])
        || changed.hasAll(['telefono', 'telefonoNormalizado']);
    }
    function resolvesPendingEmail(changed, data) {
      return !changed.hasAny(['email', 'emailNormalizado'])
        || (
          data.get('emailPendienteCorreccion', false) == false
          && (
            resource.data.get('emailPendienteCorreccion', false) == false
            || changed.hasAny(['emailPendienteCorreccion'])
          )
        );
    }
    function isValidClientCreate(clientId) {
      let data = request.resource.data;
      return hasValidClientCore(data)
        && hasExactFields(data, [
          'nombreCompleto', 'telefono', 'telefonoNormalizado', 'email',
          'emailNormalizado', 'consentimientoFirmado',
          'fusionado', 'fechaRegistro', 'creadoPor'
        ])
        && data.consentimientoFirmado == false
        && data.fusionado == false
        && data.fechaRegistro == request.time
        && data.creadoPor == request.auth.uid
        && hasRequiredIdentitiesAfter(clientId, data);
    }
    function isValidClientContactUpdate(clientId) {
      let data = request.resource.data;
      let changed = data.diff(resource.data).affectedKeys();
      return hasValidClientCore(resource.data)
        && hasValidClientCore(data)
        && resource.data.fusionado == false
        && data.fusionado == false
        && changed.hasAny([
          'telefono', 'telefonoNormalizado', 'email', 'emailNormalizado'
        ])
        && changed.hasOnly([
          'telefono', 'telefonoNormalizado', 'email', 'emailNormalizado',
          'emailPendienteCorreccion', 'actualizadaEn', 'actualizadaPor'
        ])
        && changed.hasAll(['actualizadaEn', 'actualizadaPor'])
        && data.actualizadaEn == request.time
        && data.actualizadaPor == request.auth.uid
        && hasPairedContactChanges()
        && resolvesPendingEmail(changed, data)
        && hasRequiredIdentitiesAfter(clientId, data)
        && releasesIdentity('telefono', resource.data.telefonoNormalizado,
          data.telefonoNormalizado)
        && releasesIdentity('correo', resource.data.emailNormalizado,
          data.emailNormalizado);
    }
    function isValidClientSignatureUpdate() {
      let data = request.resource.data;
      let changed = data.diff(resource.data).affectedKeys();
      return resource.data.get('fusionado', false) == false
        && data.get('fusionado', false) == false
        && changed.hasOnly(['consentimientoFirmado', 'firmaUrl', 'fechaFirma'])
        && changed.hasAll(['consentimientoFirmado', 'firmaUrl', 'fechaFirma'])
        && data.nombreCompleto is string
        && data.telefono is string
        && data.telefono.matches('[0-9]{10}')
        && data.email is string
        && data.consentimientoFirmado == true
        && data.firmaUrl is string && data.firmaUrl.size() > 0
        && data.firmaUrl.size() <= 900000
        && data.fechaFirma is string && data.fechaFirma.size() > 0;
    }
    match /clientes/{clientId} {
      allow read: if canReadOperations();
      allow create: if isReceptionOrAdmin() && isValidClientCreate(clientId);
      allow update: if isReceptionOrAdmin()
        && (
          isValidClientContactUpdate(clientId)
          || isValidClientSignatureUpdate()
        );
      allow delete: if false;
    }
    function hasValidIdentityData(identityId, data) {
      return hasExactFields(data, [
          'tipo', 'valorNormalizado', 'clienteId', 'creadaEn', 'creadaPor'
        ])
        && data.tipo in ['telefono', 'correo']
        && data.valorNormalizado is string
        && data.clienteId is string && data.clienteId.size() > 0
        && data.creadaEn is timestamp
        && data.creadaPor is string
        && (
          (data.tipo == 'telefono'
            && identityId == 'telefono:' + data.valorNormalizado
            && data.valorNormalizado.matches('[0-9]{10}'))
          || (data.tipo == 'correo'
            && identityId == 'correo:' + data.valorNormalizado
            && data.valorNormalizado.size() > 0
            && data.valorNormalizado.size() <= 254
            && data.valorNormalizado == data.valorNormalizado.lower()
            && !data.valorNormalizado.matches('.*[/].*'))
        );
    }
    function contactChanged(beforeData, afterData) {
      return afterData.diff(beforeData).affectedKeys().hasAny([
        'telefono', 'telefonoNormalizado', 'email', 'emailNormalizado'
      ]);
    }
    function clientAdoptsIdentity(data) {
      let afterData = clientAfter(data.clienteId);
      return existsAfter(/databases/$(database)/documents/clientes/$(data.clienteId))
        && (
          !exists(/databases/$(database)/documents/clientes/$(data.clienteId))
          || contactChanged(clientBefore(data.clienteId), afterData)
        )
        && (
          (data.tipo == 'telefono'
            && afterData.telefonoNormalizado == data.valorNormalizado)
          || (data.tipo == 'correo'
            && afterData.emailNormalizado == data.valorNormalizado)
        );
    }
    function clientReleasesIdentity(data) {
      let beforeData = clientBefore(data.clienteId);
      let afterData = clientAfter(data.clienteId);
      return exists(/databases/$(database)/documents/clientes/$(data.clienteId))
        && existsAfter(/databases/$(database)/documents/clientes/$(data.clienteId))
        && afterData.diff(beforeData).affectedKeys().hasOnly([
          'telefono', 'telefonoNormalizado', 'email', 'emailNormalizado',
          'emailPendienteCorreccion', 'actualizadaEn', 'actualizadaPor'
        ])
        && (
          (data.tipo == 'telefono'
            && beforeData.telefonoNormalizado == data.valorNormalizado
            && afterData.telefonoNormalizado != data.valorNormalizado)
          || (data.tipo == 'correo'
            && beforeData.emailNormalizado == data.valorNormalizado
            && afterData.emailNormalizado != data.valorNormalizado)
        );
    }
    match /identidadesClientes/{identityId} {
      allow read: if isReceptionOrAdmin();
      allow create: if isReceptionOrAdmin()
        && hasValidIdentityData(identityId, request.resource.data)
        && request.resource.data.creadaEn == request.time
        && request.resource.data.creadaPor == request.auth.uid
        && clientAdoptsIdentity(request.resource.data);
      allow update: if false;
      allow delete: if isReceptionOrAdmin()
        && hasValidIdentityData(identityId, resource.data)
        && clientReleasesIdentity(resource.data);
    }
    // Citas anticipos y cupos
    function twoDigits(value) { return value < 10 ? '0' + string(value) : string(value); }
    function dateKeyFromTimestamp(value) {
      return string(value.year())
        + '-' + twoDigits(value.month())
        + '-' + twoDigits(value.day());
    }
    function isValidDateKey(value) {
      return value is string
        && value.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}');
    }
    function isAllowedAppointmentTime(value) { return value in ['10:00', '14:00', '17:00']; }
    function hasExpectedUtcHour(localTime, startTime) {
      return (
          localTime == '10:00' && startTime.hours() == 16
        )
        || (
          localTime == '14:00' && startTime.hours() == 20
        )
        || (
          localTime == '17:00' && startTime.hours() == 23
        );
    }
    function hasValidAppointmentStart(data) {
      return data.inicio is timestamp
        && isValidDateKey(data.fecha)
        && isAllowedAppointmentTime(data.hora)
        && dateKeyFromTimestamp(data.inicio) == data.fecha
        && hasExpectedUtcHour(data.hora, data.inicio)
        && data.inicio.dayOfWeek() != 7
        && data.inicio.minutes() == 0
        && data.inicio.seconds() == 0
        && data.inicio.nanos() == 0
        && data.inicio >= request.time + duration.value(15, 'm');
    }
    function hasValidDepositEntry(entry) {
      return entry is map
        && entry.keys().hasOnly([
          'metodo', 'montoCentavos', 'efectivoRecibidoCentavos',
          'cambioCentavos', 'referencia', 'ultimosCuatro'
        ])
        && entry.metodo in ['efectivo', 'tarjeta', 'transferencia']
        && entry.montoCentavos is int && entry.montoCentavos > 0
        && entry.efectivoRecibidoCentavos is int
        && entry.efectivoRecibidoCentavos >= 0
        && entry.cambioCentavos is int && entry.cambioCentavos >= 0
        && entry.referencia is string && entry.referencia.size() <= 120
        && entry.ultimosCuatro is string
        && (
          (entry.metodo == 'efectivo'
            && entry.efectivoRecibidoCentavos >= entry.montoCentavos
            && entry.cambioCentavos
              == entry.efectivoRecibidoCentavos - entry.montoCentavos
            && entry.referencia == '' && entry.ultimosCuatro == '')
          || (entry.metodo == 'transferencia'
            && entry.efectivoRecibidoCentavos == 0
            && entry.cambioCentavos == 0
            && entry.referencia.size() >= 3
            && entry.ultimosCuatro == '')
          || (entry.metodo == 'tarjeta'
            && entry.efectivoRecibidoCentavos == 0
            && entry.cambioCentavos == 0
            && (
              entry.ultimosCuatro == ''
              || entry.ultimosCuatro.matches('[0-9]{4}')
            ))
        );
    }
    function hasValidSingleDeposit(data) {
      return data.anticipoMetodo in ['efectivo', 'tarjeta', 'transferencia']
        && data.anticipoPagos.size() == 1
        && hasValidDepositEntry(data.anticipoPagos[0])
        && data.anticipoPagos[0].metodo == data.anticipoMetodo
        && data.anticipoPagos[0].montoCentavos == data.anticipoMontoCentavos;
    }
    function hasValidMixedDeposit(data) {
      return data.anticipoMetodo == 'mixto'
        && data.anticipoPagos.size() == 2
        && hasValidDepositEntry(data.anticipoPagos[0])
        && hasValidDepositEntry(data.anticipoPagos[1])
        && data.anticipoPagos[0].metodo != data.anticipoPagos[1].metodo
        && data.anticipoPagos[0].montoCentavos
          + data.anticipoPagos[1].montoCentavos == data.anticipoMontoCentavos;
    }
    function hasValidNewAppointmentKeys(data) {
      return data.keys().hasOnly([
          'clienteId', 'nombreCompleto', 'servicioId', 'servicio',
          'precioServicio', 'precioServicioCentavos', 'duracionMinutos',
          'duracionServicioMinutos', 'tiempoPreparacionMinutos',
          'duracionBloqueMinutos', 'fecha', 'hora', 'inicio',
          'finTratamiento', 'finBloque', 'estado', 'anticipoPagado',
          'anticipoPorcentaje', 'anticipoMontoCentavos', 'anticipoMetodo',
          'anticipoPagos', 'recordatorioEnviado', 'cupoId',
          'creadaEn', 'creadaPor', 'schemaVersion'
        ]);
    }
    function hasValidAppointmentClient(data) {
      let client = clientAfter(data.clienteId);
      return data.clienteId is string
        && client.fusionado != true
        && client.nombreCompleto is string
        && client.telefonoNormalizado is string
        && client.emailNormalizado is string
        && data.nombreCompleto == client.nombreCompleto;
    }
    function hasValidAppointmentService(data) {
      let serviceData = serviceAfter(data.servicioId);
      return data.servicioId is string
        && serviceData.activo == true
        && data.servicio == serviceData.nombre
        && data.precioServicioCentavos == serviceData.precioCentavos
        && data.precioServicio == serviceData.precioCentavos / 100.0
        && data.duracionServicioMinutos == serviceData.duracionServicioMinutos
        && data.tiempoPreparacionMinutos == serviceData.tiempoPreparacionMinutos
        && data.duracionBloqueMinutos == serviceData.duracionBloqueMinutos
        && data.anticipoPorcentaje == serviceData.porcentajeAnticipo;
    }
    function hasValidAppointmentDurations(data) {
      return data.duracionMinutos is int && data.duracionMinutos == 180
        && data.duracionServicioMinutos is int && data.duracionServicioMinutos == 150
        && data.tiempoPreparacionMinutos is int && data.tiempoPreparacionMinutos == 30
        && data.duracionBloqueMinutos is int && data.duracionBloqueMinutos == 180
        && data.finTratamiento is timestamp && data.finBloque is timestamp
        && data.finTratamiento == data.inicio + duration.value(150, 'm')
        && data.finBloque == data.inicio + duration.value(180, 'm');
    }
    function hasValidAppointmentDeposit(data) {
      return data.precioServicio is number
        && data.precioServicioCentavos is int
        && data.anticipoPagado == true
        && data.anticipoPorcentaje is int && data.anticipoPorcentaje == 30
        && data.anticipoMontoCentavos is int && data.anticipoMontoCentavos > 0
        && data.anticipoMontoCentavos
          == math.round(data.precioServicioCentavos
            * data.anticipoPorcentaje / 100.0)
        && data.anticipoPagos is list
        && (hasValidSingleDeposit(data) || hasValidMixedDeposit(data));
    }
    function hasValidSlotData(slotId, data) {
      return hasExactFields(data, [
          'citaId', 'clienteId', 'fecha', 'hora', 'inicio', 'finBloque',
          'duracionBloqueMinutos', 'creadoEn', 'creadoPor', 'schemaVersion'
        ])
        && data.citaId is string && data.citaId.size() > 0
        && data.clienteId is string && data.clienteId.size() > 0
        && isValidDateKey(data.fecha)
        && isAllowedAppointmentTime(data.hora)
        && slotId == data.fecha + '_' + data.hora
        && data.inicio is timestamp && data.finBloque is timestamp
        && data.duracionBloqueMinutos is int && data.duracionBloqueMinutos == 180
        && data.finBloque == data.inicio + duration.value(180, 'm')
        && data.creadoEn is timestamp && data.creadoPor is string
        && data.schemaVersion is int && data.schemaVersion in [1, 2, 3];
    }
    function slotAfter(slotId) { return getAfter(/databases/$(database)/documents/cupos/$(slotId)).data; }
    function appointmentBefore(appointmentId) { return get(/databases/$(database)/documents/citas/$(appointmentId)).data; }
    function appointmentAfter(appointmentId) { return getAfter(/databases/$(database)/documents/citas/$(appointmentId)).data; }
    function hasCreatedSlotAfter(slotId) {
      return !exists(/databases/$(database)/documents/cupos/$(slotId))
        && existsAfter(/databases/$(database)/documents/cupos/$(slotId));
    }
    function hasMatchingAppointmentAfter(slotId, data) {
      let appointment = appointmentAfter(data.citaId);
      return !exists(/databases/$(database)/documents/citas/$(data.citaId))
        && appointment.cupoId == slotId
        && appointment.clienteId == data.clienteId
        && appointment.fecha == data.fecha && appointment.hora == data.hora
        && appointment.inicio == data.inicio && appointment.finBloque == data.finBloque
        && appointment.duracionBloqueMinutos == data.duracionBloqueMinutos
        && appointment.creadaEn == data.creadoEn && appointment.creadaPor == data.creadoPor;
    }
    function hasValidPaymentDocument(data) {
      return data.keys().hasOnly([
          'citaId', 'ventaId', 'clienteId', 'tipo', 'metodo',
          'montoCentavos', 'partes', 'estado', 'fecha',
          'actorUid', 'sucursalId', 'schemaVersion'
        ])
        && data.ventaId == null
        && data.tipo == 'anticipo'
        && data.estado == 'confirmado'
        && data.sucursalId == 'principal'
        && data.schemaVersion == 1;
    }
    function paymentMatchesAppointment(
      payment,
      appointmentId,
      appointment
    ) {
      return payment.citaId == appointmentId
        && payment.clienteId == appointment.clienteId
        && payment.metodo == appointment.anticipoMetodo
        && payment.montoCentavos == appointment.anticipoMontoCentavos
        && payment.partes == appointment.anticipoPagos
        && payment.fecha == appointment.creadaEn
        && payment.actorUid == appointment.creadaPor;
    }
    function hasMatchingDepositPaymentAfter(appointmentId, appointment) {
      let paymentId = appointmentId + '_anticipo';
      let payment = getAfter(
        /databases/$(database)/documents/pagos/$(paymentId)
      ).data;
      return !exists(
          /databases/$(database)/documents/pagos/$(paymentId)
        )
        && hasValidPaymentDocument(payment)
        && paymentMatchesAppointment(
          payment,
          appointmentId,
          appointment
        );
    }
    function isValidDepositPaymentCreate(paymentId) {
      let data = request.resource.data;
      let appointment = appointmentAfter(data.citaId);
      return paymentId == data.citaId + '_anticipo'
        && !exists(/databases/$(database)/documents/citas/$(data.citaId))
        && appointment.creadaPor == request.auth.uid;
    }
    function isValidNewAppointment(appointmentId) {
      let data = request.resource.data;
      return hasValidNewAppointmentKeys(data)
        && hasValidAppointmentClient(data)
        && hasValidAppointmentService(data)
        && hasValidAppointmentStart(data)
        && hasValidAppointmentDurations(data)
        && hasValidAppointmentDeposit(data)
        && data.estado == 'confirmada'
        && data.recordatorioEnviado == false
        && data.cupoId == data.fecha + '_' + data.hora
        && data.creadaEn == request.time && data.creadaPor == request.auth.uid
        && data.schemaVersion is int && data.schemaVersion == 3
        && hasCreatedSlotAfter(data.cupoId)
        && hasMatchingDepositPaymentAfter(appointmentId, data);
    }
    // Historial y transiciones
    function isAllowedTrackedAppointmentTransition(previousStatus, nextStatus) {
      return (previousStatus == 'por_confirmar'
          && nextStatus in ['confirmada', 'cancelada']
        )
        || (previousStatus == 'confirmada'
          && nextStatus in ['en_cabina', 'cancelada']
        )
        || (previousStatus == 'en_cabina' && nextStatus == 'por_cobrar');
    }
    function hasValidSlotLifecycle(appointmentId, nextStatus) {
      let slotId = resource.data.get('cupoId', '');
      let schemaVersion = resource.data.get('schemaVersion', 0);
      return !(schemaVersion in [1, 2, 3])
        || (nextStatus == 'cancelada'
          && exists(/databases/$(database)/documents/cupos/$(slotId))
          && get(/databases/$(database)/documents/cupos/$(slotId)).data.citaId
            == appointmentId
          && !existsAfter(/databases/$(database)/documents/cupos/$(slotId))
        )
        || (nextStatus != 'cancelada'
          && existsAfter(/databases/$(database)/documents/cupos/$(slotId))
          && slotAfter(slotId).citaId == appointmentId
        );
    }
    function isValidTrackedAppointmentUpdate(appointmentId) {
      let previousStatus = resource.data.estado;
      let nextStatus = request.resource.data.estado;
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return isAllowedTrackedAppointmentTransition(previousStatus, nextStatus)
        && request.resource.data.actualizadaEn == request.time
        && request.resource.data.actualizadaPor == request.auth.uid
        && ((nextStatus == 'cancelada'
            && changed.hasOnly([
              'estado', 'actualizadaEn', 'actualizadaPor', 'cancelacion'
            ])
          )
          || (nextStatus != 'cancelada'
            && changed.hasOnly(['estado', 'actualizadaEn', 'actualizadaPor'])
          )
        )
        && existsAfter(
          /databases/$(database)/documents/citas/$(appointmentId)/eventos/$(nextStatus)
        )
        && hasValidSlotLifecycle(appointmentId, nextStatus);
    }
    function hasValidAppointmentEvent(appointmentId, eventId) {
      let eventData = request.resource.data;
      let beforeData = appointmentBefore(appointmentId);
      let afterData = appointmentAfter(appointmentId);
      return hasExactFields(eventData, [
          'tipo', 'estadoAnterior', 'estadoNuevo', 'motivo',
          'actorUid', 'fecha', 'anticipoResultado'
        ])
        && eventData.tipo == 'cambio_estado'
        && eventId == eventData.estadoNuevo
        && isAllowedTrackedAppointmentTransition(
          eventData.estadoAnterior, eventData.estadoNuevo
        )
        && eventData.actorUid == request.auth.uid && eventData.fecha == request.time
        && beforeData.estado == eventData.estadoAnterior
        && afterData.estado == eventData.estadoNuevo
        && afterData.actualizadaEn == request.time && afterData.actualizadaPor == request.auth.uid
        && ((eventData.estadoNuevo == 'cancelada'
            && eventData.motivo is string
            && eventData.motivo.size() >= 5 && eventData.motivo.size() <= 500
            && eventData.anticipoResultado in ['retenido', 'no_aplica']
            && afterData.cancelacion.motivo == eventData.motivo
            && afterData.cancelacion.fecha == request.time
            && afterData.cancelacion.actorUid == request.auth.uid
            && afterData.cancelacion.anticipoResultado
              == eventData.anticipoResultado
            && ((beforeData.get('anticipoPagado', false) == true
                && eventData.anticipoResultado == 'retenido')
              || (beforeData.get('anticipoPagado', false) != true
                && eventData.anticipoResultado == 'no_aplica')
            )
          )
          || (eventData.estadoNuevo != 'cancelada'
            && eventData.motivo == null
            && eventData.anticipoResultado == null
          )
        );
    }
    function isValidSlotDelete(slotId) {
      let data = resource.data;
      let beforeData = appointmentBefore(data.citaId);
      let afterData = appointmentAfter(data.citaId);
      return hasValidSlotData(slotId, data)
        && exists(/databases/$(database)/documents/citas/$(data.citaId))
        && existsAfter(/databases/$(database)/documents/citas/$(data.citaId))
        && beforeData.schemaVersion in [1, 2, 3]
        && beforeData.cupoId == slotId
        && afterData.cupoId == slotId
        && isAllowedTrackedAppointmentTransition(
          beforeData.estado, afterData.estado
        )
        && afterData.estado == 'cancelada'
        && afterData.actualizadaEn == request.time && afterData.actualizadaPor == request.auth.uid
        && existsAfter(
          /databases/$(database)/documents/citas/$(data.citaId)/eventos/cancelada
        );
    }
    match /cupos/{slotId} {
      allow read: if canReadOperations();
      allow create: if request.resource.data.keys().hasOnly([
          'citaId', 'clienteId', 'fecha', 'hora', 'inicio', 'finBloque',
          'duracionBloqueMinutos', 'creadoEn', 'creadoPor', 'schemaVersion'
        ])
        && request.resource.data.schemaVersion == 3
        && request.resource.data.creadoEn == request.time
        && request.resource.data.creadoPor == request.auth.uid
        && hasMatchingAppointmentAfter(slotId, request.resource.data);
      allow update: if false;
      allow delete: if isReceptionOrAdmin() && isValidSlotDelete(slotId);
    }
    match /citas/{appointmentId} {
      allow read: if canReadOperations();
      allow create: if isReceptionOrAdmin()
        && isValidNewAppointment(appointmentId);
      allow update: if isReceptionOrAdmin()
        && isValidTrackedAppointmentUpdate(appointmentId);
      allow delete: if false;
      match /eventos/{eventId} {
        allow read: if canReadOperations();
        allow create: if isReceptionOrAdmin()
          && hasValidAppointmentEvent(appointmentId, eventId);
        allow update, delete: if false;
      }
    }
    // Pagos registrados
    match /pagos/{paymentId} {
      allow read: if isReceptionOrAdmin();
      allow create: if isValidDepositPaymentCreate(paymentId);
      allow update, delete: if false;
    }
    // Catalogo de productos de venta
    match /productos/{productId} {
      allow read: if isReceptionOrAdmin();
      allow create, update, delete: if false;
    }
    // Ventas cerradas por servidor
    match /ventas/{saleId} {
      allow read: if isReceptionOrAdmin();
      allow create, update, delete: if false;
    }
    // Movimientos protegidos de inventario
    match /movimientosInventario/{movementId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }
    // Colecciones heredadas
    match /pacientes/{patientId} {
      allow read, create, update: if isAdmin() || isClinical();
      allow delete: if false;
    }
    // Cierre por defecto
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
