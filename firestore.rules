rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Comprueba que existe una sesión activa
    function isSignedIn() {
      // Devuelve el estado de autenticación
      return request.auth != null;
    }

    // Comprueba el rol activo del usuario
    function hasRole(role) {
      // Devuelve la coincidencia del rol
      return isSignedIn()
        && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.activo == true
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == role;
    }

    // Comprueba el acceso administrativo
    function isAdmin() {
      // Devuelve el acceso administrativo
      return hasRole('admin');
    }

    // Comprueba el acceso de recepción
    function isReception() {
      // Devuelve el acceso de recepción
      return hasRole('recepcion');
    }

    // Comprueba el acceso clínico
    function isClinical() {
      // Devuelve el acceso clínico
      return hasRole('cosmetologa');
    }

    // Comprueba el acceso operativo
    function isReceptionOrAdmin() {
      // Devuelve el acceso operativo
      return isReception() || isAdmin();
    }

    // Comprueba el acceso al usuario propio
    function isOwnUser(userId) {
      // Devuelve la coincidencia por identidad
      return isSignedIn()
        && (
          userId == request.auth.uid
          || (
            request.auth.token.email is string
            && request.auth.token.email_verified == true
            && resource.data.correo == request.auth.token.email
          )
        );
    }

    // Comprueba la estructura del usuario
    function hasValidUserData() {
      // Devuelve la validez de los campos de acceso
      return request.resource.data.correo is string
        && request.resource.data.rol in ['admin', 'recepcion', 'cosmetologa']
        && request.resource.data.activo is bool;
    }

    match /usuarios/{userId} {
      allow read: if isAdmin() || isOwnUser(userId);
      allow create: if isAdmin() && hasValidUserData();
      allow update: if isAdmin()
        && hasValidUserData()
        && (
          userId != request.auth.uid
          || (
            request.resource.data.rol == 'admin'
            && request.resource.data.activo == true
          )
        );
      allow delete: if isAdmin() && userId != request.auth.uid;
    }

    match /clientes/{clientId} {
      allow read: if isReceptionOrAdmin() || isClinical();
      allow create, update: if isReceptionOrAdmin();
      allow delete: if false;
    }

    // Comprueba una transición operativa de cita
    function isAllowedTrackedAppointmentTransition(
      previousStatus,
      nextStatus
    ) {
      // Devuelve la validez de la transición
      return (
          previousStatus == 'por_confirmar'
          && nextStatus in ['confirmada', 'cancelada']
        )
        || (
          previousStatus == 'confirmada'
          && nextStatus in ['en_cabina', 'cancelada']
        )
        || (
          previousStatus == 'en_cabina'
          && nextStatus == 'completada'
        );
    }

    // Comprueba una actualización auditada de cita
    function isValidTrackedAppointmentUpdate(appointmentId) {
      // Obtiene los estados y campos modificados
      let previousStatus = resource.data.estado;
      let nextStatus = request.resource.data.estado;
      let changedFields = request.resource.data
        .diff(resource.data)
        .affectedKeys();

      // Devuelve la validez de la actualización
      return isAllowedTrackedAppointmentTransition(
          previousStatus,
          nextStatus
        )
        && request.resource.data.actualizadaEn == request.time
        && request.resource.data.actualizadaPor == request.auth.uid
        && (
          (
            nextStatus == 'cancelada'
            && changedFields.hasOnly([
              'estado',
              'actualizadaEn',
              'actualizadaPor',
              'cancelacion'
            ])
          )
          || (
            nextStatus != 'cancelada'
            && changedFields.hasOnly([
              'estado',
              'actualizadaEn',
              'actualizadaPor'
            ])
          )
        )
        && existsAfter(
          /databases/$(database)/documents/citas/$(appointmentId)/eventos/$(nextStatus)
        );
    }

    // Conserva la compatibilidad temporal con el cobro
    function isValidLegacyCheckoutUpdate() {
      // Obtiene los campos modificados
      let changedFields = request.resource.data
        .diff(resource.data)
        .affectedKeys();

      // Devuelve la única transición heredada permitida
      return resource.data.estado == 'completada'
        && request.resource.data.estado == 'finalizada'
        && changedFields.hasOnly(['estado']);
    }

    // Comprueba la integridad de un evento auditado
    function hasValidAppointmentEvent(appointmentId, eventId) {
      // Obtiene el evento y las versiones de la cita
      let eventData = request.resource.data;
      let appointmentBefore = get(
        /databases/$(database)/documents/citas/$(appointmentId)
      ).data;
      let appointmentAfter = getAfter(
        /databases/$(database)/documents/citas/$(appointmentId)
      ).data;

      // Devuelve la validez del evento y su transición
      return eventData.keys().hasAll([
          'tipo',
          'estadoAnterior',
          'estadoNuevo',
          'motivo',
          'actorUid',
          'fecha',
          'anticipoResultado'
        ])
        && eventData.keys().hasOnly([
          'tipo',
          'estadoAnterior',
          'estadoNuevo',
          'motivo',
          'actorUid',
          'fecha',
          'anticipoResultado'
        ])
        && eventData.tipo == 'cambio_estado'
        && eventId == eventData.estadoNuevo
        && isAllowedTrackedAppointmentTransition(
          eventData.estadoAnterior,
          eventData.estadoNuevo
        )
        && eventData.actorUid == request.auth.uid
        && eventData.fecha == request.time
        && appointmentBefore.estado == eventData.estadoAnterior
        && appointmentAfter.estado == eventData.estadoNuevo
        && appointmentAfter.actualizadaEn == request.time
        && appointmentAfter.actualizadaPor == request.auth.uid
        && (
          (
            eventData.estadoNuevo == 'cancelada'
            && eventData.motivo is string
            && eventData.motivo.size() >= 5
            && eventData.motivo.size() <= 500
            && eventData.anticipoResultado in ['retenido', 'no_aplica']
            && appointmentAfter.cancelacion.motivo == eventData.motivo
            && appointmentAfter.cancelacion.fecha == request.time
            && appointmentAfter.cancelacion.actorUid == request.auth.uid
            && appointmentAfter.cancelacion.anticipoResultado
              == eventData.anticipoResultado
            && (
              (
                appointmentBefore.get('anticipoPagado', false) == true
                && eventData.anticipoResultado == 'retenido'
              )
              || (
                appointmentBefore.get('anticipoPagado', false) != true
                && eventData.anticipoResultado == 'no_aplica'
              )
            )
          )
          || (
            eventData.estadoNuevo != 'cancelada'
            && eventData.motivo == null
            && eventData.anticipoResultado == null
          )
        );
    }

    match /citas/{appointmentId} {
      allow read: if isReceptionOrAdmin() || isClinical();
      allow create: if isReceptionOrAdmin();
      allow update: if isReceptionOrAdmin()
        && (
          isValidTrackedAppointmentUpdate(appointmentId)
          || isValidLegacyCheckoutUpdate()
        );
      allow delete: if false;

      match /eventos/{eventId} {
        allow read: if isReceptionOrAdmin() || isClinical();
        allow create: if isReceptionOrAdmin()
          && hasValidAppointmentEvent(appointmentId, eventId);
        allow update, delete: if false;
      }
    }

    match /ventas/{saleId} {
      allow read, create: if isReceptionOrAdmin();
      allow update, delete: if false;
    }

    match /pacientes/{patientId} {
      allow read, create, update: if isAdmin() || isClinical();
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
