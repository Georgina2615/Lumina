rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Acceso por identidad y rol
    function isSignedIn() { return request.auth != null; }
    function hasAnyRole(roles) {
      return isSignedIn()
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.activo == true
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol in roles;
    }
    function hasRole(role) { return hasAnyRole([role]); }
    function isAdmin() { return hasRole('admin'); }
    function isClinical() { return hasRole('cosmetologa'); }
    function isReceptionOrAdmin() { return hasAnyRole(['recepcion', 'admin']); }
    function canReadOperations() {
      return hasAnyRole(['recepcion', 'admin', 'cosmetologa']);
    }
    function isOwnUser(userId) {
      return isSignedIn()
        && (
          userId == request.auth.uid
          || (
            request.auth.token.email is string
            && request.auth.token.email_verified == true
            && resource.data.correo == request.auth.token.email
          )
        );
    }
    function hasValidUserData() {
      return request.resource.data.correo is string
        && request.resource.data.rol in ['admin', 'recepcion', 'cosmetologa']
        && request.resource.data.activo is bool;
    }
    function hasExactFields(data, fields) {
      return data.keys().hasAll(fields) && data.keys().hasOnly(fields);
    }
    match /usuarios/{userId} {
      allow read: if isAdmin() || isOwnUser(userId);
      allow create: if isAdmin() && hasValidUserData();
      allow update: if isAdmin()
        && hasValidUserData()
        && (
          userId != request.auth.uid
          || (
            request.resource.data.rol == 'admin'
            && request.resource.data.activo == true
          )
        );
      allow delete: if isAdmin() && userId != request.auth.uid;
    }
    // Catalogo de servicios
    // Las funciones seguras administran los cambios
    match /servicios/{serviceId} {
      allow read: if canReadOperations();
      allow create, update, delete: if false;
    }
    // Historial privado de cambios en servicios
    match /cambiosServicios/{changeId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }
    // Clientes e identidades normalizadas
    function clientBefore(clientId) { return get(/databases/$(database)/documents/clientes/$(clientId)).data; }
    function clientAfter(clientId) { return getAfter(/databases/$(database)/documents/clientes/$(clientId)).data; }
    function identityAfter(identityId) {
      return getAfter(/databases/$(database)/documents/identidadesClientes/$(identityId)).data;
    }
    function hasValidClientName(value) {
      return value is string
        && value == value.trim()
        && value.size() >= 2 && value.size() <= 150
        && value.matches(
          "[A-Za-zÁÉÍÓÚÜÑáéíóúüñ]+([ '’-][A-Za-zÁÉÍÓÚÜÑáéíóúüñ]+)*"
        );
    }
    function hasValidClientPhone(phone, normalizedPhone) {
      return phone is string && normalizedPhone is string
        && phone == normalizedPhone
        && normalizedPhone.matches('[0-9]{10}');
    }
    function hasValidClientEmail(email, normalizedEmail) {
      return email is string && normalizedEmail is string
        && email == email.trim()
        && email == normalizedEmail
        && normalizedEmail == normalizedEmail.lower()
        && normalizedEmail.size() <= 254
        && !normalizedEmail.matches('.*[/].*')
        && (normalizedEmail == ''
          || normalizedEmail.matches('[^/@ ]+@[^/@ ]+[.][^/@ ]+'));
    }
    function hasValidClientEmailState(data) {
      let pendingCorrection = data.get('emailPendienteCorreccion', false);
      return pendingCorrection is bool
        && (
          (pendingCorrection == false
            && hasValidClientEmail(data.email, data.emailNormalizado)
          )
          || (pendingCorrection == true
            && data.email is string
            && data.email == data.email.trim()
            && data.email.size() > 0
            && data.email.size() <= 254
            && data.emailNormalizado is string
            && data.emailNormalizado == ''
          )
        );
    }
    function hasValidMigrationAudit(data) {
      let hasMigrationAudit = data.keys().hasAny(['migradoEn', 'migradoPor']);
      return !hasMigrationAudit
        || (
          data.keys().hasAll(['migradoEn', 'migradoPor'])
          && data.migradoEn is timestamp
          && data.migradoPor is string
          && data.migradoPor.size() > 0
        );
    }
    function hasValidClientCreator(data) {
      return (data.creadoPor is string && data.creadoPor.size() > 0)
        || (
          data.creadoPor == null
          && data.keys().hasAll(['migradoEn', 'migradoPor'])
          && data.migradoEn is timestamp
          && data.migradoPor is string
          && data.migradoPor.size() > 0
        );
    }
    function hasValidClientMerge(data) {
      let mergeFields = [
        'fusionadoCon', 'fusionadoEn', 'fusionadoPor', 'motivoFusion'
      ];
      return (data.fusionado == false && !data.keys().hasAny(mergeFields))
        || (
          data.fusionado == true
          && data.keys().hasAll(mergeFields)
          && data.fusionadoCon is string
          && data.fusionadoCon.size() > 0
          && data.fusionadoEn is timestamp
          && data.fusionadoPor is string
          && data.fusionadoPor.size() > 0
          && data.motivoFusion == 'duplicado_contacto'
        );
    }
    function hasValidClientCore(data) {
      return data.keys().hasAll([
          'nombreCompleto', 'telefono', 'telefonoNormalizado', 'email',
          'emailNormalizado', 'consentimientoFirmado',
          'fusionado', 'fechaRegistro', 'creadoPor'
        ])
        && data.keys().hasOnly([
          'nombreCompleto', 'telefono', 'telefonoNormalizado', 'email',
          'emailNormalizado', 'consentimientoFirmado', 'fusionado', 'fechaRegistro',
          'creadoPor', 'firmaUrl', 'fechaFirma', 'actualizadaEn', 'actualizadaPor',
          'emailPendienteCorreccion', 'migradoEn', 'migradoPor',
          'fusionadoCon', 'fusionadoEn', 'fusionadoPor', 'motivoFusion'
        ])
        && hasValidClientName(data.nombreCompleto)
        && hasValidClientPhone(data.telefono, data.telefonoNormalizado)
        && hasValidClientEmailState(data)
        && data.consentimientoFirmado is bool
        && data.fusionado is bool
        && data.fechaRegistro is timestamp
        && hasValidMigrationAudit(data)
        && hasValidClientCreator(data)
        && hasValidClientMerge(data)
        && data.get('firmaUrl', '') is string
        && data.get('fechaFirma', '') is string
        && data.get('actualizadaEn', request.time) is timestamp
        && data.get('actualizadaPor', '') is string;
    }
    function hasIdentityAfter(clientId, type, value) {
      let identityId = type + ':' + value;
      let identity = identityAfter(identityId);
      return identity.tipo == type
        && identity.valorNormalizado == value
        && identity.clienteId == clientId;
    }
    function hasRequiredIdentitiesAfter(clientId, data) {
      return hasIdentityAfter(clientId, 'telefono', data.telefonoNormalizado)
        && (
          data.emailNormalizado == ''
          || hasIdentityAfter(clientId, 'correo', data.emailNormalizado)
        );
    }
    function releasesIdentity(type, previousValue, nextValue) {
      let identityId = type + ':' + previousValue;
      return previousValue == ''
        || previousValue == nextValue
        || !existsAfter(/databases/$(database)/documents/identidadesClientes/$(identityId));
    }
    function hasPairedContactChanges() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return !changed.hasAny(['telefono', 'telefonoNormalizado'])
        || changed.hasAll(['telefono', 'telefonoNormalizado']);
    }
    function resolvesPendingEmail(changed, data) {
      return !changed.hasAny(['email', 'emailNormalizado'])
        || (
          data.get('emailPendienteCorreccion', false) == false
          && (
            resource.data.get('emailPendienteCorreccion', false) == false
            || changed.hasAny(['emailPendienteCorreccion'])
          )
        );
    }
    function isValidClientCreate(clientId) {
      let data = request.resource.data;
      return hasValidClientCore(data)
        && hasExactFields(data, [
          'nombreCompleto', 'telefono', 'telefonoNormalizado', 'email',
          'emailNormalizado', 'consentimientoFirmado',
          'fusionado', 'fechaRegistro', 'creadoPor'
        ])
        && data.consentimientoFirmado == false
        && data.fusionado == false
        && data.fechaRegistro == request.time
        && data.creadoPor == request.auth.uid
        && hasRequiredIdentitiesAfter(clientId, data);
    }
    function isValidClientContactUpdate(clientId) {
      let data = request.resource.data;
      let changed = data.diff(resource.data).affectedKeys();
      return hasValidClientCore(resource.data)
        && hasValidClientCore(data)
        && resource.data.fusionado == false
        && data.fusionado == false
        && changed.hasAny([
          'telefono', 'telefonoNormalizado', 'email', 'emailNormalizado'
        ])
        && changed.hasOnly([
          'telefono', 'telefonoNormalizado', 'email', 'emailNormalizado',
          'emailPendienteCorreccion', 'actualizadaEn', 'actualizadaPor'
        ])
        && changed.hasAll(['actualizadaEn', 'actualizadaPor'])
        && data.actualizadaEn == request.time
        && data.actualizadaPor == request.auth.uid
        && hasPairedContactChanges()
        && resolvesPendingEmail(changed, data)
        && hasRequiredIdentitiesAfter(clientId, data)
        && releasesIdentity('telefono', resource.data.telefonoNormalizado,
          data.telefonoNormalizado)
        && releasesIdentity('correo', resource.data.emailNormalizado,
          data.emailNormalizado);
    }
    function isValidClientSignatureUpdate() {
      let data = request.resource.data;
      let changed = data.diff(resource.data).affectedKeys();
      return resource.data.get('fusionado', false) == false
        && data.get('fusionado', false) == false
        && changed.hasOnly(['consentimientoFirmado', 'firmaUrl', 'fechaFirma'])
        && changed.hasAll(['consentimientoFirmado', 'firmaUrl', 'fechaFirma'])
        && data.nombreCompleto is string
        && data.telefono is string
        && data.telefono.matches('[0-9]{10}')
        && data.email is string
        && data.consentimientoFirmado == true
        && data.firmaUrl is string && data.firmaUrl.size() > 0
        && data.firmaUrl.size() <= 900000
        && data.fechaFirma is string && data.fechaFirma.size() > 0;
    }
    match /clientes/{clientId} {
      allow read: if canReadOperations();
      allow create: if isReceptionOrAdmin() && isValidClientCreate(clientId);
      allow update: if isReceptionOrAdmin()
        && (
          isValidClientContactUpdate(clientId)
          || isValidClientSignatureUpdate()
        );
      allow delete: if false;
    }
    function hasValidIdentityData(identityId, data) {
      return hasExactFields(data, [
          'tipo', 'valorNormalizado', 'clienteId', 'creadaEn', 'creadaPor'
        ])
        && data.tipo in ['telefono', 'correo']
        && data.valorNormalizado is string
        && data.clienteId is string && data.clienteId.size() > 0
        && data.creadaEn is timestamp
        && data.creadaPor is string
        && (
          (data.tipo == 'telefono'
            && identityId == 'telefono:' + data.valorNormalizado
            && data.valorNormalizado.matches('[0-9]{10}'))
          || (data.tipo == 'correo'
            && identityId == 'correo:' + data.valorNormalizado
            && data.valorNormalizado.size() > 0
            && data.valorNormalizado.size() <= 254
            && data.valorNormalizado == data.valorNormalizado.lower()
            && !data.valorNormalizado.matches('.*[/].*'))
        );
    }
    function contactChanged(beforeData, afterData) {
      return afterData.diff(beforeData).affectedKeys().hasAny([
        'telefono', 'telefonoNormalizado', 'email', 'emailNormalizado'
      ]);
    }
    function clientAdoptsIdentity(data) {
      let afterData = clientAfter(data.clienteId);
      return existsAfter(/databases/$(database)/documents/clientes/$(data.clienteId))
        && (
          !exists(/databases/$(database)/documents/clientes/$(data.clienteId))
          || contactChanged(clientBefore(data.clienteId), afterData)
        )
        && (
          (data.tipo == 'telefono'
            && afterData.telefonoNormalizado == data.valorNormalizado)
          || (data.tipo == 'correo'
            && afterData.emailNormalizado == data.valorNormalizado)
        );
    }
    function clientReleasesIdentity(data) {
      let beforeData = clientBefore(data.clienteId);
      let afterData = clientAfter(data.clienteId);
      return exists(/databases/$(database)/documents/clientes/$(data.clienteId))
        && existsAfter(/databases/$(database)/documents/clientes/$(data.clienteId))
        && afterData.diff(beforeData).affectedKeys().hasOnly([
          'telefono', 'telefonoNormalizado', 'email', 'emailNormalizado',
          'emailPendienteCorreccion', 'actualizadaEn', 'actualizadaPor'
        ])
        && (
          (data.tipo == 'telefono'
            && beforeData.telefonoNormalizado == data.valorNormalizado
            && afterData.telefonoNormalizado != data.valorNormalizado)
          || (data.tipo == 'correo'
            && beforeData.emailNormalizado == data.valorNormalizado
            && afterData.emailNormalizado != data.valorNormalizado)
        );
    }
    match /identidadesClientes/{identityId} {
      allow read: if isReceptionOrAdmin();
      allow create: if isReceptionOrAdmin()
        && hasValidIdentityData(identityId, request.resource.data)
        && request.resource.data.creadaEn == request.time
        && request.resource.data.creadaPor == request.auth.uid
        && clientAdoptsIdentity(request.resource.data);
      allow update: if false;
      allow delete: if isReceptionOrAdmin()
        && hasValidIdentityData(identityId, resource.data)
        && clientReleasesIdentity(resource.data);
    }
    // Citas anticipos y cupos
    // Las funciones seguras administran el ciclo de las citas
    match /cupos/{slotId} {
      allow read: if canReadOperations();
      allow create, update, delete: if false;
    }
    // Historial privado de disponibilidad
    match /cambiosDisponibilidad/{changeId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }
    match /citas/{appointmentId} {
      allow read: if canReadOperations();
      allow create: if false;
      allow update, delete: if false;
      match /eventos/{eventId} {
        allow read: if canReadOperations();
        allow create, update, delete: if false;
      }
    }
    // Pagos registrados
    match /pagos/{paymentId} {
      allow read: if isReceptionOrAdmin();
      allow create: if false;
      allow update, delete: if false;
    }
    // Catalogo de productos de venta
    match /productos/{productId} {
      allow read: if isReceptionOrAdmin();
      allow create, update, delete: if false;
    }
    // Costos privados de productos
    match /costosProductos/{productId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }
    // Ventas cerradas por servidor
    match /ventas/{saleId} {
      allow read: if isReceptionOrAdmin();
      allow create, update, delete: if false;
    }
    // Movimientos protegidos de inventario
    match /movimientosInventario/{movementId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }
    // Inventario interno de cabina
    match /insumosCabina/{supplyId} {
      allow read: if isAdmin()
        || (isClinical() && resource.data.activo == true);
      allow create, update, delete: if false;
    }
    // Costos privados de insumos de cabina
    match /costosInsumosCabina/{supplyId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }
    // Movimientos protegidos de insumos de cabina
    match /movimientosInsumosCabina/{movementId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }
    // Colecciones heredadas
    match /pacientes/{patientId} {
      allow read, create, update: if isAdmin() || isClinical();
      allow delete: if false;
    }
    // Cierre por defecto
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
